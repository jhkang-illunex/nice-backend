# 배포용 .env 템플릿 — docker-compose.deploy.yml 과 같은 폴더에 `.env` 로 복사 후 값 수정.
#   cp .env.deploy.example .env  &&  vi .env
# 미지정 항목은 compose 의 기본값이 적용됨.

# ── 이미지 태그 (docker load 된 이미지 태그와 일치) ──
APP_TAG=dev
APP_ENV=prod
LOG_LEVEL=INFO

# ── 외부 PostgreSQL (pgvector) ──
POSTGRES_HOST=host.docker.internal     # 같은 호스트에 published 면 이대로. 아니면 실제 IP/호스트
POSTGRES_PORT=5433
POSTGRES_USER=nice
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nice_innovation

# ── 외부 임베딩 (OpenAI 호환 /v1/embeddings) — rag/ingestion 필수 ──
EMBED_BASE_URL=http://host.docker.internal:18080/v1
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024

# ── 외부 LLM (OpenAI 호환) — /agent 필수 ──
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen3:14b

# ── 호스트 노출 포트 ──
RAG_API_PORT=18002
SHOCK_API_PORT=18004
