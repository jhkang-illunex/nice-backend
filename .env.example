# Copy to .env (gitignored) and adjust for local dev.
#
# 변수 명명 규칙
#   _HOST / _PORT             : 호스트(=다른 머신/쉘)에서 접근할 때 쓰는 값
#   _HOST_INTERNAL / _PORT_*  : 같은 docker compose 네트워크 안 컨테이너 끼리

# ─── PostgreSQL (server2) ─────────────────────────────────────────────────────
POSTGRES_USER=nice
POSTGRES_PASSWORD=nice
POSTGRES_DB=nice
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
# 컨테이너 끼리 (rag-server, graph-analysis, ingestion → postgres)
POSTGRES_HOST_INTERNAL=postgres
POSTGRES_PORT_INTERNAL=5432

# ─── Neo4j (server1) ──────────────────────────────────────────────────────────
NEO4J_USER=neo4j
NEO4J_PASSWORD=nice-poc-2026
NEO4J_HOST=localhost
NEO4J_BOLT_PORT=17687
NEO4J_HTTP_PORT=17474
# 컨테이너 끼리 (graph-analysis → neo4j)
NEO4J_HOST_INTERNAL=neo4j
NEO4J_BOLT_PORT_INTERNAL=7687
NEO4J_DATABASE=neo4j

# ─── Redis (server2) ──────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=16379
# 컨테이너 끼리 (rag-server → redis)
REDIS_HOST_INTERNAL=redis
REDIS_PORT_INTERNAL=6379
REDIS_DB=0

# ─── Apps — 호스트 노출 포트 ──────────────────────────────────────────────────
APP_ENV=local
LOG_LEVEL=INFO
APP_TAG=dev
GRAPH_API_PORT=18001     # server1 (graph-analysis)
RAG_API_PORT=18002       # server2 (rag-server)
LLM_PORT=11434           # server2 자체 LLM (ollama)
EMBED_PORT=18080         # server2 자체 임베딩 (TEI)

# ─── LLM 백엔드 (OpenAI-호환) ─────────────────────────────────────────────────
#  dev (ollama, profile llm-local) : http://llm:11434/v1
#  prod (vLLM, GPU + gpu.yml)       : http://llm:11434/v1   (vLLM 도 11434 로 listen)
#  외부 OpenAI                       : https://api.openai.com/v1
#  외부 Anthropic proxy(LiteLLM 등)  : https://proxy.example.com/v1
# 백엔드 교체는 LLM_BASE_URL 1줄만 변경.
#
# LLM_MODEL 표기는 백엔드별로 다름:
#   ollama : "qwen2.5:7b-instruct"        (ollama tag 형식)
#   vLLM   : "Qwen/Qwen2.5-7B-Instruct"   (HuggingFace model id)
#   OpenAI : "gpt-4o-mini" 등
LLM_BASE_URL=http://llm:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=noop
LLM_TIMEOUT_S=60
# qwen3 류 thinking 모델 제어 — 'none'=추론 끔 (ollama OpenAI-호환 경로의 유일한 제어).
# 비워두면 body 에 미포함. thinking 을 안 끄면 추론 토큰이 max_tokens 를 소진함.
LLM_REASONING_EFFORT=
# vLLM 전용 — gpu.yml 에서 사용. ollama 는 무시.
LLM_GPU_MEMORY_UTIL=0.85

# ─── 임베딩 백엔드 (OpenAI-호환 /v1/embeddings) ───────────────────────────────
#  자체 호스팅(profile embed-local): http://embed:8080/v1   (TEI CPU)
#  외부 OpenAI:                      https://api.openai.com/v1
# 백엔드 교체는 EMBED_BASE_URL 1줄만 변경.
#
# 모델: BAAI/bge-m3 (다국어 retrieval, XLM-R 기반, TEI candle 호환, 1024-d)
#   - 임베딩 차원 1024 (모델 출력 그대로 사용; truncate 불요)
#   - retrieval 권장: query 측에 instruct prefix 불요 (BGE-M3 는 raw query 권장).
#     EMBED_QUERY_INSTRUCTION 비워두면 raw 호출 — 본 PoC 기본값.
#     Qwen3-Embedding 류로 swap 시엔 prefix 채우면 자동 적용.
#   - 임베딩은 정규화하여 코사인 유사도(`vector_cosine_ops`) 색인에 사용
EMBED_BASE_URL=http://embed:8080/v1
EMBED_MODEL=BAAI/bge-m3
EMBED_API_KEY=noop
EMBED_DIM=1024
EMBED_TIMEOUT_S=30
EMBED_NORMALIZE=true
EMBED_QUERY_INSTRUCTION=

# ─── GPU (실배포 server2 에서 docker-compose.gpu.yml 사용 시) ─────────────────
# GPU 수/특정 인덱스 지정은 docker-compose.gpu.yml 의 deploy.resources 블록을 직접 편집.
# (compose 는 devices[].count 의 환경변수 보간을 지원하지 않음 — 정수 리터럴만)
