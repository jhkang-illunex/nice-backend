    "/api/search": {
      "get": {
        "tags": [
          "search"
        ],
        "summary": "HSCode + KSIC 통합 검색 (병렬 hybrid)",
        "description": "키워드 하나로 HSCode(/api/hsk/search)와 KSIC 11차 대·중분류(/api/ksic/search)를 **병렬** 실행해 두 결과를 한 응답에 담는다. 각 도메인의 검색 파이프라인(hsk: 품목 추출·동의어 확장·CRAG / ksic: raw 질의)은 개별 엔드포인트와 동일. 한 도메인만 실패하면 200 + `errors` 로 부분 결과를 반환하고, 둘 다 실패하면 503.",
        "operationId": "search_api_search_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "검색 키워드 (품목/업종 자유 표현).",
              "examples": [
                "반도체"
              ],
              "title": "Q"
            },
            "description": "검색 키워드 (품목/업종 자유 표현)."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "description": "도메인별 반환 후보 수 (hsk·ksic 각각 적용).",
              "default": 10,
              "title": "Limit"
            },
            "description": "도메인별 반환 후보 수 (hsk·ksic 각각 적용)."
          },
          {
            "name": "hs_prefix",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{2,8}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "[hsk 전용] HS 코드 prefix 로 검색 범위 제한 (류 2자리 ~ 세번 8자리).",
              "title": "Hs Prefix"
            },
            "description": "[hsk 전용] HS 코드 prefix 로 검색 범위 제한 (류 2자리 ~ 세번 8자리)."
          },
          {
            "name": "active_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "[hsk 전용] true 면 현재 유효한(valid_to >= 오늘) 코드만 검색.",
              "default": false,
              "title": "Active Only"
            },
            "description": "[hsk 전용] true 면 현재 유효한(valid_to >= 오늘) 코드만 검색."
          },
          {
            "name": "level",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 2,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "[ksic 전용] 계층 제한 — 1=대분류만, 2=중분류만. 생략 시 둘 다.",
              "title": "Level"
            },
            "description": "[ksic 전용] 계층 제한 — 1=대분류만, 2=중분류만. 생략 시 둘 다."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedSearchResponse"
                }
              }
            }
          },
          "503": {
            "description": "두 도메인 모두 실패 (임베딩 백엔드 또는 PostgreSQL 도달 불가).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "요청 파라미터 검증 실패 (q 길이 등).",
            "content": {
              "application/json": {
