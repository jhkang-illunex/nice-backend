        "operationId": "search_api_ksic_search_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "검색 키워드 (업종명/업태 자유 표현).",
              "examples": [
                "반도체 제조"
              ],
              "title": "Q"
            },
            "description": "검색 키워드 (업종명/업태 자유 표현)."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "description": "반환할 후보 개수. 운영 권장 5~10.",
              "default": 10,
              "title": "Limit"
            },
            "description": "반환할 후보 개수. 운영 권장 5~10."
          },
          {
            "name": "level",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 2,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "계층 제한 — 1=대분류만, 2=중분류만. 생략 시 둘 다.",
              "title": "Level"
            },
            "description": "계층 제한 — 1=대분류만, 2=중분류만. 생략 시 둘 다."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/KsicHit"
                  },
                  "title": "Response Search Api Ksic Search Get"
                }
              }
            }
          },
          "503": {
            "description": "임베딩 백엔드 또는 PostgreSQL 도달 불가.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "요청 파라미터 검증 실패 (q 길이 등).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
