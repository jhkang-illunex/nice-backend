{
  "openapi": "3.1.0",
  "info": {
    "title": "NICE shock-propagate",
    "description": "triple_list 입력 순수 쇼크 전파 — 관세충격 / 거래량변동.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/shock/tariff": {
      "post": {
        "summary": "관세(외생) 충격",
        "operationId": "tariff_api_shock_tariff_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TariffRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataResponse"
                }
              }
            }
          },
          "503": {
            "description": "backend rate API 미설정 또는 도달 불가 (RATE_API_URL)"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/shock/volume": {
      "post": {
        "summary": "거래량 변동",
        "description": "국내 거래량 변동 — 시드별 주입액 = total_amount × shock_rate(기업별). **기준연도(bse_yr) 개념이 없다**: tariff 와 달리 backend 비중 조회가 없어 연도 인자를 받지 않으며, total_amount(재무 기준연도)와 triple_list(거래 기준연도)의 연도 정합은 호출자 책임이다.",
        "operationId": "volume_api_shock_volume_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VolumeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/shock/propagate": {
      "post": {
        "summary": "저수준 전파(edges+init)",
        "operationId": "propagate_api_shock_propagate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PropagateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DirectionOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "헬스체크",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DampedCycleOut": {
        "properties": {
          "members": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Members"
          },
          "rho": {
            "type": "number",
            "title": "Rho"
          },
          "factor": {
            "type": "number",
            "title": "Factor"
          },
          "rho_after": {
            "type": "number",
            "title": "Rho After"
          }
        },
        "type": "object",
        "required": [
          "members",
          "rho",
          "factor",
          "rho_after"
        ],
        "title": "DampedCycleOut"
      },
      "DataResponse": {
        "properties": {
          "direction": {
            "type": "string",
            "enum": [
              "import",
              "export"
            ],
            "title": "Direction",
            "description": "import=매입 / export=매출 (입력 echo)"
          },
          "total_shock": {
            "type": "number",
            "title": "Total Shock"
          },
          "data_list": {
            "items": {
              "$ref": "#/components/schemas/NodeOut"
            },
            "type": "array",
            "title": "Data List"
          },
          "excluded_seeds": {
            "items": {
              "$ref": "#/components/schemas/ExcludedSeedOut"
            },
            "type": "array",
            "title": "Excluded Seeds",
            "description": "전파에서 제외된 시드와 사유 (init·depth·total_shock 미포함). 비어 있지 않으면 시드/그래프 조립 불일치 신호."
          }
        },
        "type": "object",
        "required": [
          "direction",
          "total_shock",
          "data_list"
        ],
        "title": "DataResponse",
        "example": {
          "data_list": [
            {
              "depth": 1,
              "node_id": "b",
              "shock": 2275230.03
            },
            {
              "depth": 2,
              "node_id": "c",
              "shock": 1381064.63
            },
            {
              "depth": 2,
              "node_id": "a",
              "shock": 136513.8
            }
          ],
          "direction": "export",
          "excluded_seeds": [],
          "total_shock": 3792808.45
        }
      },
      "DirectionOut": {
        "properties": {
          "direction": {
            "type": "integer",
            "title": "Direction",
            "description": "0=매출 파급(downstream) / 1=매입 파급(upstream)"
          },
          "converged": {
            "type": "boolean",
            "title": "Converged"
          },
          "iterations": {
            "type": "integer",
            "title": "Iterations"
          },
          "total_shock": {
            "type": "number",
            "title": "Total Shock"
          },
          "shock_list": {
            "items": {
              "$ref": "#/components/schemas/ShockRowOut"
            },
            "type": "array",
            "title": "Shock List"
          },
          "damped_cycles": {
            "items": {
              "$ref": "#/components/schemas/DampedCycleOut"
            },
            "type": "array",
            "title": "Damped Cycles",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "direction",
          "converged",
          "iterations",
          "total_shock",
          "shock_list"
        ],
        "title": "DirectionOut",
        "example": {
          "converged": true,
          "damped_cycles": [],
          "direction": -1,
          "iterations": 0,
          "shock_list": [
            {
              "bizno": "a",
              "shock": 1.0
            },
            {
              "bizno": "b",
              "shock": 0.5
            }
          ],
          "total_shock": 1.5
        }
      },
      "ExcludedSeedOut": {
        "properties": {
          "node_id": {
            "type": "string",
            "title": "Node Id",
            "description": "제외된 시드 seed_id(사업자번호)"
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "description": "제외 사유 — 그래프(from∪to) 미포함 / rate 조회 실패 등"
          }
        },
        "type": "object",
        "required": [
          "node_id",
          "reason"
        ],
        "title": "ExcludedSeedOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NodeOut": {
        "properties": {
          "node_id": {
            "type": "string",
            "title": "Node Id"
          },
          "shock": {
            "type": "number",
            "title": "Shock"
          },
          "depth": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Depth",
            "description": "시드=1, 시드에서 홉당 +1 (도달 못하면 null)"
          }
        },
        "type": "object",
        "required": [
          "node_id",
          "shock"
        ],
        "title": "NodeOut"
      },
      "PropagateRequest": {
        "properties": {
          "triple_list": {
            "items": {
              "$ref": "#/components/schemas/TripleIn"
            },
            "type": "array",
            "title": "Triple List"
          },
          "init": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Init",
            "description": "노드별 초기값 {bizno: shock 또는 δ}"
          },
          "method": {
            "type": "string",
            "title": "Method",
            "default": "scc"
          },
          "cycle_damping": {
            "type": "number",
            "exclusiveMaximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Cycle Damping",
            "default": 0.95
          }
        },
        "type": "object",
        "required": [
          "triple_list",
          "init"
        ],
        "title": "PropagateRequest",
        "description": "edges 와 init 을 그대로 받는 저수준 전파.\n\ntriple_list 는 이미 전파 방향으로 정향·정규화된 엣지(클라이언트가 조립).\ninit 은 노드별 초기값({node: shock/δ}). pin·방향·δ 산출은 호출자(nice_dbtool) 책임.",
        "example": {
          "init": {
            "a": 1.0
          },
          "triple_list": [
            {
              "from": "a",
              "rate": 0.5,
              "to": "b"
            }
          ]
        }
      },
      "ShockRowOut": {
        "properties": {
          "bizno": {
            "type": "string",
            "title": "Bizno"
          },
          "shock": {
            "type": "number",
            "title": "Shock"
          },
          "depth": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Depth",
            "description": "시드=1, 시드에서 홉당 +1 (도달 못하면 null)"
          }
        },
        "type": "object",
        "required": [
          "bizno",
          "shock"
        ],
        "title": "ShockRowOut"
      },
      "TariffRequest": {
        "properties": {
          "triple_list": {
            "items": {
              "$ref": "#/components/schemas/TripleIn"
            },
            "type": "array",
            "title": "Triple List",
            "description": "거래쌍·거래비율 엣지 목록"
          },
          "bse_yr": {
            "type": "string",
            "pattern": "^\\d{4}$",
            "title": "Bse Yr",
            "description": "기준 연도 — 수출입 비중(/trade/weight) 조회 기준. 기본 2025 (2026 데이터 불충분).",
            "default": "2025"
          },
          "shock_rate": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Shock Rate",
            "description": "충격 비율 (전 시드 공통, 0~1 강제). 시드별 주입액 = total_amount(손익계산서 매출액) × Σrate(backend 조회, 각 0~1) × shock_rate"
          },
          "seed_list": {
            "items": {
              "$ref": "#/components/schemas/TariffSeedIn"
            },
            "type": "array",
            "title": "Seed List",
            "description": "외생충격 받는 1차 기업 [{seed_id, upche_cd, total_amount, hscodes}] — rate 는 전 시드의 (upche_cd × hscodes) 를 backend API(RATE_API_URL, POST /trade/weight) 로 **일괄 조회**"
          },
          "direction": {
            "type": "string",
            "enum": [
              "import",
              "export"
            ],
            "title": "Direction",
            "description": "import=매입(기본) / export=매출 — 전파 방향과 rate 조회 방향(tseximdivcd 3/0)에 공통 적용",
            "default": "import"
          }
        },
        "type": "object",
        "required": [
          "triple_list",
          "shock_rate",
          "seed_list"
        ],
        "title": "TariffRequest",
        "example": {
          "bse_yr": "2025",
          "direction": "export",
          "seed_list": [
            {
              "hscodes": [
                "3801300000",
                "3901100000"
              ],
              "seed_id": "b",
              "total_amount": 10000000.0,
              "upche_cd": "184084"
            }
          ],
          "shock_rate": 0.1,
          "triple_list": [
            {
              "from": "a",
              "rate": 0.115,
              "to": "b"
            },
            {
              "from": "b",
              "rate": 0.06,
              "to": "a"
            },
            {
              "from": "c",
              "rate": 0.912,
              "to": "b"
            },
            {
              "from": "b",
              "rate": 0.607,
              "to": "c"
            }
          ]
        }
      },
      "TariffSeedIn": {
        "properties": {
          "seed_id": {
            "type": "string",
            "title": "Seed Id",
            "description": "기업 사업자등록번호(bizno) — triple_list 의 node_id 와 동일 체계"
          },
          "upche_cd": {
            "type": "string",
            "title": "Upche Cd",
            "description": "업체코드 — rate(수출입 비중) 조회 키 (hscode 와 함께 사용)"
          },
          "total_amount": {
            "type": "number",
            "minimum": 0.0,
            "title": "Total Amount",
            "description": "이 기업의 총매출(원) — 손익계산서(ab01·ac01) 매출액"
          },
          "hscodes": {
            "items": {
              "type": "string",
              "pattern": "^\\d{10}$"
            },
            "type": "array",
            "minItems": 1,
            "title": "Hscodes",
            "description": "품목코드 목록 (HS 10자리 digit) — backend /trade/weight 일괄 조회로 품목별 수출(입) 비중을 받아 **합산**(Σ). 중복 코드는 dedup 후 합산하고 backend 가 H10 단일 계층만 반환하므로 이중계상 여지 없음. 실적 없는 품목은 비중 0 취급, 전 품목 실적 없음이면 시드 excluded."
          }
        },
        "type": "object",
        "required": [
          "seed_id",
          "upche_cd",
          "total_amount",
          "hscodes"
        ],
        "title": "TariffSeedIn"
      },
      "TripleIn": {
        "properties": {
          "from": {
            "type": "string",
            "title": "From",
            "description": "셀러(거래 출발) bizno"
          },
          "to": {
            "type": "string",
            "title": "To",
            "description": "바이어(거래 도착) bizno"
          },
          "rate": {
            "type": "number",
            "title": "Rate",
            "description": "거래비율(trade_rate, source 정규화)"
          }
        },
        "type": "object",
        "required": [
          "from",
          "to",
          "rate"
        ],
        "title": "TripleIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VolumeRequest": {
        "properties": {
          "triple_list": {
            "items": {
              "$ref": "#/components/schemas/TripleIn"
            },
            "type": "array",
            "title": "Triple List"
          },
          "seed_list": {
            "items": {
              "$ref": "#/components/schemas/VolumeSeedIn"
            },
            "type": "array",
            "title": "Seed List",
            "description": "변동 대상 1차 기업 [{seed_id, total_amount, shock_rate}] — 기업별 변동 비율을 개별 입력"
          },
          "direction": {
            "type": "string",
            "enum": [
              "import",
              "export"
            ],
            "title": "Direction",
            "description": "import=매입(기본) / export=매출",
            "default": "import"
          }
        },
        "type": "object",
        "required": [
          "triple_list",
          "seed_list"
        ],
        "title": "VolumeRequest",
        "example": {
          "direction": "export",
          "seed_list": [
            {
              "seed_id": "b",
              "shock_rate": 0.2,
              "total_amount": 1000000.0
            }
          ],
          "triple_list": [
            {
              "from": "a",
              "rate": 0.115,
              "to": "b"
            },
            {
              "from": "b",
              "rate": 0.607,
              "to": "c"
            }
          ]
        }
      },
      "VolumeSeedIn": {
        "properties": {
          "seed_id": {
            "type": "string",
            "title": "Seed Id",
            "description": "기업 사업자등록번호(bizno) — triple_list 의 node_id 와 동일 체계"
          },
          "total_amount": {
            "type": "number",
            "minimum": 0.0,
            "title": "Total Amount",
            "description": "이 기업의 총매출(원) — 손익계산서(ab01·ac01) 매출액 (매입 기준이면 매입 총액)"
          },
          "shock_rate": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Shock Rate",
            "description": "이 기업의 충격 비율 (0~1 강제, 0=무변화, 예: 0.2=20%). 주입액(충격 금액) = total_amount(총매출) × shock_rate"
          }
        },
        "type": "object",
        "required": [
          "seed_id",
          "total_amount",
          "shock_rate"
        ],
        "title": "VolumeSeedIn"
      }
    }
  }
}
